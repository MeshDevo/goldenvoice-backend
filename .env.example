# Golden Voice — environment (copy to .env in this folder;
# the application loads it via dotenv when it starts).

# Port of the single Golden Voice application (pages + services, one
# process, one origin).
PORT=4000

# PostgreSQL connection for Prisma.
DATABASE_URL=postgresql://user:password@localhost:5432/golden_voice

# JWT signing used by the auth service (required by features that call it).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

NODE_ENV=development
